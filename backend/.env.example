# CELESTIA Backend Environment Configuration Example
# Copy to .env and configure for local or production use.

# Environment: "development", "testing", or "production"
ENV=development

# JWT Secret Key (MUST be at least 32 cryptographically random characters in production)
# In production, generate using: openssl rand -hex 32
SECRET_KEY=celestia_development_secret_key_at_least_32_characters_long

# JWT Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URL (PostgreSQL required for production)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/celestia
DATABASE_URL=sqlite:///./celestia.db

# Demo Account Flag (strictly disabled in production)
DEMO_ACCOUNT_ENABLED=true

# Strict CORS Allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted Proxies for Reverse Proxy Deployment (comma-separated IPs/CIDRs)
TRUSTED_PROXIES=127.0.0.1,::1

# AI Gateway Configuration
AI_PAUSED_GLOBAL=false
AI_PER_USER_DAILY_BUDGET=50
AI_PER_CALL_TIMEOUT_SEC=15.0

# Optional External AI API Keys (fallback to deterministic engine if blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
